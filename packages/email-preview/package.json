{
  "name": "@tallystone/preact-email-preview",
  "version": "0.1.1",
  "description": "Local, email previews for Preact projects",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "preact-email-preview": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "esbuild": "catalog:",
    "htmlparser2": "catalog:"
  },
  "peerDependencies": {
    "@tallystone/preact-email": "^0.1.0",
    "preact": "catalog:"
  },
  "devDependencies": {
    "@tallystone/preact-email": "workspace:*",
    "preact": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tallystone/preact-email.git",
    "directory": "packages/email-preview"
  }
}
